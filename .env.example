# Base URL for the remote Ollama target (CLAUDE.md decision #1 exception — build-time
# config, remote target only; the local target stays runtime-resolved).
#
# Must be a full base URL (scheme + host + port), not a bare hostname — e.g. a Tailscale
# address on port 11434. Copy this file to .env.local (gitignored) and fill in the real
# value; if unset, the remote target is simply unavailable and the app falls back to the
# plain "modèle local" label with no switch shown.
VITE_REMOTE_OLLAMA_HOST=http://<remote-tailscale-host>:11434
